# App Configuration
APP_NAME="VolksEnergies Tender OCR"
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Postgres Database Configuration
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/tender_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tender_db

# Redis Configuration
REDIS_URL=redis://127.0.0.1:6379/0

# MinIO Configuration
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_RAW=tender-raw
MINIO_BUCKET_PROCESSED=tender-processed

# Gemini API — LLM fallback layer for GAIL/GeM ATC parsing
# Replace with your real Gemini API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-1.5-flash
LLM_FALLBACK_ENABLED=true
LLM_MAX_EXAMPLES_PER_FIELD=5

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# SMTP Configuration (Ethereal test account)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=kaden.emard61@ethereal.email
SMTP_PASSWORD=J4Mpzk4fe2Duwpq58n
