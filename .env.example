# App Configuration
APP_NAME="VolksEnergies Tender OCR"
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Postgres Database Configuration
# Internal container URL: postgresql://<user>:<password>@postgres:5432/<db_name>
# Host URL: postgresql://<user>:<password>@localhost:5432/<db_name>
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/tender_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tender_db

# Redis Configuration
# Internal container URL: redis://redis:6379/0
# Host URL: redis://localhost:6379/0
REDIS_URL=redis://redis:6379/0

# MinIO Configuration
# Internal container URL: minio:9000
# Host URL: localhost:9000
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_RAW=tender-raw
MINIO_BUCKET_PROCESSED=tender-processed

# LLM Configuration (Anthropic Claude, Gemini, or Groq)
ANTHROPIC_API_KEY=your_claude_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
ANTHROPIC_FAST_MODEL=claude-haiku-4-5-20251001
LLM_PROVIDER=anthropic

# Gemini API Key (Optional for basic OCR, required for intelligent parsing)
GEMINI_API_KEY=your_gemini_api_key_here

# CORS Configuration (comma-separated list of origins)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# SMTP Configuration
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=your_smtp_username_here
SMTP_PASSWORD=your_smtp_password_here
SMTP_FROM=your_smtp_sender_email_here

# Telegram Bot Configuration for Team Notifications
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Qdrant Vector Database Configuration (Week 4)
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=your_qdrant_api_key_here

# Neo4j Graph Database Configuration (Week 4)
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here
